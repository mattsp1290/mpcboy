{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "cacheVariables": {
        "MPCBOY_TARGET": "native"
      }
    },
    {
      "name": "native-asan",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g"
      }
    },
    {
      "name": "native-ubsan",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "native-tsan",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g"
      }
    },
    {
      "name": "mac-vst",
      "inherits": "base",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "cacheVariables": {
        "MPCBOY_TARGET": "mac-vst",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "arm32",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/zig-arm32.cmake"
    },
    {
      "name": "arm64",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/zig-arm64.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "native-ubsan",
      "configurePreset": "native-ubsan"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan"
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan"
    },
    {
      "name": "mac-vst",
      "configurePreset": "mac-vst"
    },
    {
      "name": "arm32",
      "configurePreset": "arm32"
    },
    {
      "name": "arm64",
      "configurePreset": "arm64"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-ubsan",
      "configurePreset": "native-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
