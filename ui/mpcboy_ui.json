{
  "mpc": {
    "style": {
      "background": "ff1c1d27",
      "accent": "ffe8558a",
      "text": "ffeceae4",
      "muted": "ffa3a7b0"
    },
    "pages": [
      {
        "name": "MAIN",
        "controls": [
          { "param": "PU1 Level", "widget": "fader",  "polarity": "unipolar" },
          { "param": "PU2 Level", "widget": "fader",  "polarity": "unipolar" },
          { "param": "WAV Level", "widget": "switch" },
          { "param": "NOI Level", "widget": "fader",  "polarity": "unipolar" },

          { "param": "PU1 Table", "widget": "slider", "overlay": "menu" },
          { "param": "PU2 Table", "widget": "slider", "overlay": "menu" },
          { "param": "WAV Table", "widget": "slider", "overlay": "menu" },
          { "param": "NOI Table", "widget": "slider", "overlay": "menu" },

          { "param": "Table Sync",   "widget": "switch" },
          { "param": "Table Rate",   "widget": "slider", "overlay": "menu", "visibleWhen": { "param": "Table Sync", "choice": "Tempo" } },
          { "param": "Table Start",  "widget": "switch", "visibleWhen": { "param": "Table Sync", "choice": "Tempo" } },
          { "param": "Vel to Level", "widget": "switch" },

          { "param": "Volume",     "widget": "fader", "polarity": "unipolar" },
          { "param": "Bend Range", "widget": "knob",  "polarity": "unipolar" },
          { "param": "Retrigger",  "widget": "switch" },
          { "param": "Note Off",   "widget": "switch" }
        ]
      },
      {
        "name": "PULSE1",
        "controls": [
          "empty",
          "empty",
          "empty",
          { "param": "PU1 On", "widget": "switch" },

          { "param": "PU1 Duty",  "widget": "switch" },
          { "param": "PU1 Semi",  "widget": "knob", "polarity": "bipolar" },
          { "param": "PU1 Fine",  "widget": "knob", "polarity": "bipolar" },
          { "param": "PU1 Table", "widget": "slider", "overlay": "menu" },

          { "param": "PU1 Level",    "widget": "fader", "polarity": "unipolar" },
          { "param": "PU1 Env Dir",  "widget": "switch" },
          { "param": "PU1 Env Time", "widget": "knob",  "polarity": "unipolar" },
          { "param": "PU1 Length",   "widget": "knob",  "polarity": "unipolar" },

          { "param": "PU1 Swp Time", "widget": "knob",   "polarity": "unipolar" },
          { "param": "PU1 Swp Dir",  "widget": "switch" },
          { "param": "PU1 Swp Amt",  "widget": "knob",   "polarity": "unipolar" },
          { "param": "PU1 Pan",      "widget": "switch" }
        ]
      },
      {
        "name": "PULSE2",
        "controls": [
          "empty",
          "empty",
          "empty",
          { "param": "PU2 On", "widget": "switch" },

          { "param": "PU2 Duty",  "widget": "switch" },
          { "param": "PU2 Semi",  "widget": "knob", "polarity": "bipolar" },
          { "param": "PU2 Fine",  "widget": "knob", "polarity": "bipolar" },
          { "param": "PU2 Table", "widget": "slider", "overlay": "menu" },

          { "param": "PU2 Level",    "widget": "fader", "polarity": "unipolar" },
          { "param": "PU2 Env Dir",  "widget": "switch" },
          { "param": "PU2 Env Time", "widget": "knob",  "polarity": "unipolar" },
          { "param": "PU2 Length",   "widget": "knob",  "polarity": "unipolar" },

          "empty",
          "empty",
          "empty",
          { "param": "PU2 Pan", "widget": "switch" }
        ]
      },
      {
        "name": "WAVE",
        "controls": [
          "empty",
          "empty",
          "empty",
          { "param": "WAV On", "widget": "switch" },

          { "param": "WAV Shape", "widget": "slider", "overlay": "menu" },
          { "param": "WAV Semi",  "widget": "knob", "polarity": "bipolar" },
          { "param": "WAV Fine",  "widget": "knob", "polarity": "bipolar" },
          { "param": "WAV Table", "widget": "slider", "overlay": "menu" },

          { "param": "WAV Level",  "widget": "switch" },
          "empty",
          "empty",
          { "param": "WAV Length", "widget": "knob", "polarity": "unipolar" },

          "empty",
          "empty",
          "empty",
          { "param": "WAV Pan", "widget": "switch" }
        ]
      },
      {
        "name": "NOISE",
        "controls": [
          "empty",
          "empty",
          "empty",
          { "param": "NOI On", "widget": "switch" },

          { "param": "NOI Mode",  "widget": "switch" },
          { "param": "NOI Semi",  "widget": "knob", "polarity": "bipolar" },
          { "param": "NOI Pitch", "widget": "switch" },
          { "param": "NOI Table", "widget": "slider", "overlay": "menu" },

          { "param": "NOI Level",    "widget": "fader", "polarity": "unipolar" },
          { "param": "NOI Env Dir",  "widget": "switch" },
          { "param": "NOI Env Time", "widget": "knob",  "polarity": "unipolar" },
          { "param": "NOI Length",   "widget": "knob",  "polarity": "unipolar" },

          "empty",
          { "param": "NOI FixPitch", "widget": "knob", "polarity": "unipolar", "visibleWhen": { "param": "NOI Pitch", "choice": "Fixed" } },
          "empty",
          { "param": "NOI Pan", "widget": "switch" }
        ]
      },
      {
        "name": "TABLE",
        "controls": [
          "empty",
          "empty",
          { "param": "Edit Table", "widget": "knob", "polarity": "unipolar" },
          { "param": "Edit Row",   "widget": "knob", "polarity": "unipolar" },

          "empty",
          "empty",
          { "param": "Row Vol",  "widget": "knob", "polarity": "unipolar" },
          { "param": "Row Semi", "widget": "knob", "polarity": "bipolar" },

          { "param": "Row Cmd1", "widget": "slider", "overlay": "menu" },
          { "param": "Row Val1", "widget": "knob", "polarity": "unipolar" },
          { "param": "Row Cmd2", "widget": "slider", "overlay": "menu" },
          { "param": "Row Val2", "widget": "knob", "polarity": "unipolar" },

          { "param": "Import File", "widget": "knob", "polarity": "unipolar" },
          { "param": "Import Now",  "widget": "switch" },
          { "param": "Import Undo", "widget": "switch" },
          { "param": "Import Scan", "widget": "switch" }
        ]
      }
    ]
  },
